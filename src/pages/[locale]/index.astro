---
import { mediaProps } from '../../content/image-dims';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StatusPanel from '../../components/StatusPanel.astro';
import OpsBrief from '../../components/OpsBrief.astro';
import SituationReport from '../../components/SituationReport.astro';
import StartPath from '../../components/StartPath.astro';
import FieldManual from '../../components/FieldManual.astro';
import ReferenceDesk from '../../components/ReferenceDesk.astro';
import YouTube from '../../components/YouTube.astro';
import Icon from '../../components/Icon.astro';
import { getUi } from '../../i18n/ui';
import { LOCALES, link, pick, type Locale } from '../../i18n/utils';
import { ogPath } from '../../lib/og';
import { GUIDES, getGuide } from '../../content/guides';
import { entriesByKind } from '../../content/heroes';
import { WORLD } from '../../content/world';
import { STORE, SITE } from '../../consts';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const ui = getUi(locale);
const path = '/';
const intro = pick(WORLD.intro, locale);
const gods = entriesByKind('god');
const bosses = entriesByKind('boss');
const topTips = GUIDES.filter((g) => ['survive-night', 'build-town', 'haul-throw'].includes(g.slug));
const featuredVideos = [
  { id: 'JAnaIQkwYOo', title: { en: 'Official Launch Trailer', fr: 'Bande-annonce de lancement', de: 'Launch-Trailer', es: 'Tráiler de lanzamiento', it: 'Trailer di lancio ufficiale' } },
  { id: 'ALzGWccYmt0', title: { en: 'Community Town Showcase', fr: 'Showcase communautaire', de: 'Community-Showcase', es: 'Showcase comunitario', it: 'Showcase della community' } },
];
---
<Base
  locale={locale}
  title={`${SITE.name} — ${ui['footer.tagline']}`}
  description={pick(SITE.description, locale)}
  path={path}
  breadcrumbs={[{ label: SITE.name, href: link(locale, '/') }]}
  ogImage={ogPath(locale, 'home')}
  jsonLd={{
    '@type': 'VideoGame',
    name: SITE.name,
    description: SITE.description,
    genre: 'Action-Adventure',
    gamePlatform: ['PC', 'Steam'],
    numberOfPlayers: '1-8',
    inLanguage: locale,
  }}
>
  <Header locale={locale} path={path} />

  <main class="mx-auto max-w-6xl px-4">
    <!-- HERO: field-guide opening with status panel -->
    <section class="grid items-start gap-8 py-12 md:grid-cols-2">
      <div class="reveal-ready">
        <p class="font-display text-sm uppercase tracking-[0.3em] text-gold-600" data-i18n="status.eyebrow">{ui['status.eyebrow']}</p>
        <h1 class="mt-3 font-display text-4xl font-black leading-tight text-roman-700 md:text-5xl">
          {SITE.name} — {ui['nav.guides']}
        </h1>
        <p class="mt-4 max-w-md text-lg text-ink-700">{intro}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={link(locale, '/guides/survive-night')}
            data-i18n="startpath.cta"
            class="w-full rounded bg-roman-600 px-5 py-2.5 text-center font-semibold text-parchment-50 transition-colors hover:bg-roman-500 sm:w-auto"
          >
            {ui['startpath.cta']}
          </a>
          <a
            href={link(locale, '/guides')}
            data-i18n="cta.read"
            class="w-full rounded border border-gold-600/50 px-5 py-2.5 text-center font-semibold text-roman-600 transition-colors hover:bg-gold-400/10 sm:w-auto"
          >
            {ui['cta.read']}
          </a>
          <a
            href="https://romestead.wiki.gg/"
            target="_blank"
            rel="noopener"
            class="w-full rounded border border-gold-600/50 px-5 py-2.5 text-center font-semibold text-roman-600 transition-colors hover:bg-gold-400/10 sm:w-auto"
          >
            Romestead Wiki ↗
          </a>
        </div>
        <div class="mt-6"><StatusPanel locale={locale} /></div>
      </div>

      <div class="reveal-ready">
        <YouTube id="JAnaIQkwYOo" title={pick(SITE.description, locale)} class="shadow-xl" />
        <div class="mt-4 grid grid-cols-2 gap-3">
          <figure class="overflow-hidden rounded-lg border border-gold-600/20 shadow-sm">
            <img {...mediaProps('screens/town-nice.jpg')} alt={ui['hero.shot.town']} loading="lazy" class="h-28 w-full object-cover sm:h-32" />
            <figcaption class="bg-parchment-50 px-2.5 py-1.5 text-[11px] text-ink-600">{ui['hero.shot.town']}</figcaption>
          </figure>
          <figure class="overflow-hidden rounded-lg border border-gold-600/20 shadow-sm">
            <img {...mediaProps('screens/fight-cyclops.webp')} alt={ui['hero.shot.fight']} loading="lazy" class="h-28 w-full object-cover sm:h-32" />
            <figcaption class="bg-parchment-50 px-2.5 py-1.5 text-[11px] text-ink-600">{ui['hero.shot.fight']}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- OPS BRIEF: live counts -->
    <OpsBrief locale={locale} />

    <!-- SITUATION REPORT -->
    <SituationReport locale={locale} />

    <!-- START PATH -->
    <StartPath locale={locale} />

    <!-- FIELD MANUAL -->
    <FieldManual locale={locale} />

    <!-- PLAYER GUIDES & VIDEOS -->
    <section class="py-8">
      <h2 class="font-display text-2xl font-bold text-roman-700">{ui['playerGuides']}</h2>
      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        {featuredVideos.map((v) => (
          <div class="reveal-ready">
            <YouTube id={v.id} title={pick(v.title, locale)} />
            <a
              href={`https://www.youtube.com/watch?v=${v.id}`}
              target="_blank"
              rel="noopener"
              class="mt-2 inline-block text-sm font-semibold text-roman-600 hover:underline"
            >{ui['watchYoutube']} ↗</a>
          </div>
        ))}
      </div>
    </section>

    <!-- COMMON FIRST-RUN MISTAKES — INTERACTIVE TIMELINE -->
    <section class="py-8">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-display text-2xl font-bold text-roman-700">{ui['mistakes']}</h2>
        <span class="text-sm text-ink-600">{ui['mistakes.hint']}</span>
      </div>
      <ol class="pitfall-timeline mt-6">
        {topTips.map((g, i) => {
          const sec = pick(g.sections, locale)[0];
          const img = g.cover ?? (g.gallery && g.gallery[0]) ?? '';
          return (
          <li class="pitfall-wrap">
            <details class="pitfall" name="pitfalls">
              <summary class="pitfall__summary">
                <span class="pitfall__node">{i + 1}</span>
                <span class="pitfall__head">
                  <span class="pitfall__title">{g.tip ? pick(g.tip, locale) : pick(g.title, locale)}</span>
                  {g.mustRead && <span class="pitfall__badge">{ui['mustread']}</span>}
                </span>
                <span class="pitfall__chev" aria-hidden="true">▾</span>
              </summary>
              <div class="pitfall__body">
                <img {...mediaProps(img)} alt={pick(g.title, locale)} class="pitfall__media" loading="lazy" />
                <div class="pitfall__text">
                  {sec && (
                    <>
                      <h3 class="pitfall__subh">{sec.h}</h3>
                      {sec.p.map((para) => <p>{para}</p>)}
                    </>
                  )}
                  <a href={link(locale, `/guides/${g.slug}`)} class="pitfall__more">{ui['cta.read']} →</a>
                </div>
              </div>
            </details>
          </li>
          );
        })}
      </ol>
    </section>

    <!-- GODS & FOES TEASER -->
    <section class="py-8">
      <div class="flex items-end justify-between">
        <h2 class="font-display text-2xl font-bold text-roman-700">{ui['nav.heroes']}</h2>
        <a href={link(locale, '/heroes')} class="text-sm text-roman-600 hover:underline">{ui['cta.read']} →</a>
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {[...gods, ...bosses].map((e) => (
          <a
            href={link(locale, `/heroes/${e.slug}`)}
            class="reveal-ready group overflow-hidden rounded-lg border border-gold-600/30 bg-parchment-50 shadow-sm transition-transform hover:-translate-y-1"
          >
            {e.image ? (
              <img {...mediaProps(e.image)} alt={e.name} loading="lazy" class="h-36 w-full object-cover" />
            ) : (
              <div class="flex h-36 items-center justify-center bg-ink-800 text-gold-400"><Icon name="landmark" class="h-10 w-10" /></div>
            )}
            <div class="p-4">
              <h3 class="font-display text-lg font-bold text-ink-800 group-hover:text-roman-600">{e.name}</h3>
              <p class="text-xs text-ink-700/70">{pick(e.role, locale)}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- REFERENCE DESK -->
    <ReferenceDesk locale={locale} />

    <!-- WORLD TEASER -->
    <section class="py-8">
      <div class="rounded-lg border border-gold-600/30 bg-ink-800 p-8 text-parchment-100">
        <h2 class="font-display text-2xl font-bold text-gold-400">{ui['nav.world']}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {WORLD.biomes.map((b) => (
            <div class="overflow-hidden rounded-lg border border-gold-600/20">
              {b.image && <img {...mediaProps(b.image)} alt={pick(b.name, locale)} loading="lazy" class="h-32 w-full object-cover" />}
              <div class="p-4">
                <h3 class="font-display text-lg font-bold text-parchment-50">{pick(b.name, locale)}</h3>
                <p class="mt-1 text-sm text-parchment-200/80">{pick(b.desc, locale)}</p>
              </div>
            </div>
          ))}
        </div>
        <a href={link(locale, '/world')} class="mt-6 inline-block text-gold-400 hover:underline">{ui['cta.read']} →</a>
      </div>
    </section>

    <!-- EXTERNAL -->
    <section class="py-8">
      <div class="grid gap-4 sm:grid-cols-3">
        <a href="https://romestead.wiki.gg/" target="_blank" rel="noopener" class="flex items-center justify-center gap-2 rounded-lg border border-gold-600/30 bg-parchment-50 p-5 text-center font-semibold text-roman-600 transition-colors hover:bg-gold-400/10"><Icon name="book" class="h-5 w-5" /> Romestead Wiki ↗</a>
        <a href={STORE.discord} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 rounded-lg border border-gold-600/30 bg-parchment-50 p-5 text-center font-semibold text-roman-600 transition-colors hover:bg-gold-400/10"><Icon name="chat" class="h-5 w-5" /> Discord ↗</a>
        <a href={STORE.steam} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 rounded-lg border border-gold-600/30 bg-parchment-50 p-5 text-center font-semibold text-roman-600 transition-colors hover:bg-gold-400/10"><Icon name="gamepad" class="h-5 w-5" /> Steam ↗</a>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Base>
