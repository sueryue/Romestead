---
import { getUi } from '../i18n/ui';
import { link, type Locale } from '../i18n/utils';
import { SITE, STORE } from '../consts';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUi(locale);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-gold-600/30 bg-ink-900 text-parchment-100">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <!-- Community CTA band -->
    <div class="footer__community">
      <div class="footer__community-text">
        <p class="footer__community-title flex items-center gap-2"><Icon name="swords" class="h-4 w-4" /> {ui['footer.community.title']}</p>
        <p class="footer__community-desc">{ui['footer.community.desc']}</p>
        <p class="footer__community-note">{ui['footer.community.note']}</p>
      </div>
      <a href={STORE.discord} class="footer__community-cta" target="_blank" rel="noopener noreferrer">
        <Icon name="chat" class="h-4 w-4" /> {ui['footer.community.cta']} ↗
      </a>
    </div>

    <!-- Main columns: brand + explore / reference / community -->
    <div class="mt-10 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <p class="flex items-center gap-2 font-display text-2xl font-bold text-gold-400">
          <Icon name="landmark" class="h-6 w-6" /> Romestead
        </p>
        <p class="mt-2 max-w-sm text-sm text-parchment-200" data-i18n="footer.tagline">{ui['footer.tagline']}</p>
        <p class="mt-4 text-xs font-bold uppercase tracking-wide text-gold-400/80" data-i18n="footer.about.title">{ui['footer.about.title']}</p>
        <p class="mt-2 max-w-md text-xs leading-relaxed text-parchment-300/80" data-i18n="footer.about.text">{ui['footer.about.text']}</p>
      </div>

      <nav>
        <p class="text-xs font-bold uppercase tracking-wide text-gold-400/80" data-i18n="footer.nav.explore">{ui['footer.nav.explore']}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={link(locale, '/')} class="hover:text-gold-400" data-i18n="nav.home">{ui['nav.home']}</a></li>
          <li><a href={link(locale, '/guides')} class="hover:text-gold-400" data-i18n="nav.guides">{ui['nav.guides']}</a></li>
          <li><a href={link(locale, '/world')} class="hover:text-gold-400" data-i18n="nav.world">{ui['nav.world']}</a></li>
          <li><a href={link(locale, '/map')} class="hover:text-gold-400" data-i18n="nav.map">{ui['nav.map']}</a></li>
        </ul>
      </nav>

      <nav>
        <p class="text-xs font-bold uppercase tracking-wide text-gold-400/80" data-i18n="footer.nav.reference">{ui['footer.nav.reference']}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={link(locale, '/heroes')} class="hover:text-gold-400" data-i18n="nav.heroes">{ui['nav.heroes']}</a></li>
          <li><a href={link(locale, '/bestiary')} class="hover:text-gold-400" data-i18n="nav.bestiary">{ui['nav.bestiary']}</a></li>
          <li><a href={link(locale, '/faq')} class="hover:text-gold-400" data-i18n="nav.faq">{ui['nav.faq']}</a></li>
          <li><a href="https://romestead.wiki.gg/" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400">Romestead Wiki ↗</a></li>
        </ul>
      </nav>

      <nav>
        <p class="text-xs font-bold uppercase tracking-wide text-gold-400/80" data-i18n="footer.nav.community">{ui['footer.nav.community']}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={STORE.discord} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-gold-400">
              <Icon name="chat" class="h-3.5 w-3.5" /> Discord ↗
            </a>
          </li>
          <li>
            <a href={STORE.steam} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-gold-400">
              <Icon name="gamepad" class="h-3.5 w-3.5" /> Steam ↗
            </a>
          </li>
          <li>
            <a href={STORE.youtube} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-gold-400">
              <Icon name="play" class="h-3.5 w-3.5" /> YouTube ↗
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Feedback / error-report strip -->
    <div class="mt-10 flex flex-col gap-3 rounded-lg border border-gold-600/25 bg-parchment-50/5 px-5 py-4 md:flex-row md:items-center md:justify-between">
      <p class="text-sm">
        <span class="font-semibold text-gold-400" data-i18n="footer.feedback.title">{ui['footer.feedback.title']}</span>
        <span class="text-parchment-200/90"> {ui['footer.feedback.text']}</span>
      </p>
      <a
        href={STORE.discord}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-fit items-center gap-1.5 rounded bg-gold-400/15 px-3 py-1.5 text-xs font-semibold text-gold-400 transition-colors hover:bg-gold-400/25"
        data-i18n="footer.feedback.cta"
      >
        <Icon name="chat" class="h-3.5 w-3.5" /> {ui['footer.feedback.cta']} ↗
      </a>
    </div>

    <!-- Legal line -->
    <div class="mt-8 border-t border-gold-600/20 pt-6">
      <p class="text-xs leading-relaxed text-parchment-300/60" data-i18n="footer.disclaimer">{ui['footer.disclaimer']}</p>
      <p class="mt-3 text-xs text-parchment-300/70">
        © {year} {SITE.author}. <span data-i18n="footer.rights">{ui['footer.rights']}</span>
        <span class="mx-1.5 text-gold-600/50" aria-hidden="true">·</span>
        <span data-i18n="footer.built">{ui['footer.built']}</span>
      </p>
    </div>
  </div>
</footer>
