---
import { getUi } from '../i18n/ui';
import type { Locale } from '../i18n/utils';
import { GUIDES } from '../content/guides';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUi(locale);

// Real, verifiable figures computed once at build time — no fake live counters.
const guideCount = GUIDES.length;
const latest = GUIDES.reduce(
  (max, g) => (g.updated > max ? g.updated : max),
  GUIDES[0]?.updated ?? '',
);
const latestLabel = latest
  ? new Date(`${latest}T00:00:00`).toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' })
  : '';
---

<div class="rounded border border-gold-600/30 bg-parchment-50 px-4 py-3 text-sm shadow-sm">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-ink-700">
    <span><strong class="text-roman-600">{guideCount}</strong> {ui['live.guides']}</span>
    <span aria-hidden="true" class="text-gold-600">·</span>
    <span>
      <span data-i18n="live.latest">{ui['live.latest']}</span>
      <time datetime={latest}>{latestLabel}</time>
    </span>
  </div>
</div>
